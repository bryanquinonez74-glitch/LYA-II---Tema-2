<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.braynsystem.generadorci.controller.NotacionesController"
        spacing="18"
        style="-fx-background-color: #F3F4F6;">

    <padding>
        <Insets
                top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>
    <Label
            text="Notaciones"
            style="
            -fx-font-size: 26px;
            -fx-font-weight: bold;
            -fx-text-fill: #1F2937;
            "/>

    <Label
            text="Conversión de expresiones entre notación infija, prefija y postfija."
            style="
            -fx-font-size: 14px;
            -fx-text-fill: #6B7280;
            "/>
    <Label
            text="Ingresa una expresión:"
            style="
            -fx-font-size: 15px;
            -fx-font-weight: bold;
            -fx-text-fill: #374151;
            "/>

    <TextField
            fx:id="txtExpresion"
            prefHeight="42"
            style="
            -fx-font-size: 15px;
            -fx-background-radius: 7px;
            -fx-border-radius: 7px;
            -fx-border-color: #D1D5DB;
            "/>

    <HBox spacing="10">

        <Button
                text="Infija"
                onAction="#mostrarInfija"
                prefWidth="130"
                prefHeight="40"
                style="
                -fx-background-color: #2563EB;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

        <Button
                text="Prefija"
                onAction="#convertirPrefija"
                prefWidth="130"
                prefHeight="40"
                style="
                -fx-background-color: #2563EB;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

        <Button
                text="Postfija"
                onAction="#convertirPostfija"
                prefWidth="130"
                prefHeight="40"
                style="
                -fx-background-color: #2563EB;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

        <Button
                text="Limpiar"
                onAction="#limpiar"
                prefWidth="110"
                prefHeight="40"
                style="
                -fx-background-color: #EF4444;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

    </HBox>
    <Label
            text="Resultado"
            style="
            -fx-font-size: 15px;
            -fx-font-weight: bold;
            -fx-text-fill: #374151;
            "/>

    <TextArea
            fx:id="txtResultado"
            editable="false"
            wrapText="true"
            prefHeight="250"
            style="
            -fx-font-family: Consolas;
            -fx-font-size: 16px;
            "/>

</VBox>