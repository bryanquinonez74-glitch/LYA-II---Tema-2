<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.braynsystem.generadorci.controller.VariablesController"
        spacing="16"
        style="-fx-background-color: #F3F4F6;">

    <padding>
        <Insets
                top="25"
                right="35"
                bottom="25"
                left="35"/>
    </padding>

    <Label
            text="Variables y Constantes"
            style="
            -fx-font-size: 26px;
            -fx-font-weight: bold;
            -fx-text-fill: #1F2937;
            "/>

    <Label
            text="Analiza declaraciones e identifica variables, constantes, tipos y valores."
            wrapText="true"
            style="
            -fx-font-size: 14px;
            -fx-text-fill: #6B7280;
            "/>

    <Label
            text="Ingresa las declaraciones:"
            style="
            -fx-font-size: 15px;
            -fx-font-weight: bold;
            "/>

    <TextArea
            fx:id="txtCodigo"
            prefHeight="140"
            wrapText="true"
            style="
            -fx-font-family: Consolas;
            -fx-font-size: 14px;
            "/>

    <HBox spacing="10">

        <Button
                text="Analizar"
                onAction="#analizar"
                prefWidth="130"
                prefHeight="40"
                style="
                -fx-background-color: #2563EB;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

        <Button
                text="Limpiar"
                onAction="#limpiar"
                prefWidth="110"
                prefHeight="40"
                style="
                -fx-background-color: #EF4444;
                -fx-text-fill: white;
                -fx-font-weight: bold;
                -fx-background-radius: 7px;
                -fx-cursor: hand;
                "/>

    </HBox>

    <Label
            fx:id="lblMensaje"
            style="
            -fx-font-size: 14px;
            -fx-text-fill: #2563EB;
            "/>

    <TableView
            fx:id="tablaVariables"
            prefHeight="280">

        <columns>

            <TableColumn
                    fx:id="colTipo"
                    text="Tipo"
                    prefWidth="130"/>

            <TableColumn
                    fx:id="colNombre"
                    text="Nombre"
                    prefWidth="160"/>

            <TableColumn
                    fx:id="colValor"
                    text="Valor"
                    prefWidth="180"/>

            <TableColumn
                    fx:id="colClase"
                    text="Clase"
                    prefWidth="150"/>

        </columns>

    </TableView>

</VBox>