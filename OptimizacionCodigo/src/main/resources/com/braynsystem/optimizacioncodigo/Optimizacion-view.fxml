<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.braynsystem.optimizacioncodigo.controller.OptimizadorCController"
            style="-fx-background-color: #f3f4f6;">

    <top>
        <VBox spacing="5"
              style="-fx-background-color: #111827;">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label text="Optimizador de Código"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>
        </VBox>
    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Seleccione el tipo de análisis:"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <ComboBox fx:id="cmbTipoOptimizacion"
                      prefWidth="350"
                      promptText="Seleccione una opción"/>

            <Label text="Código de entrada:"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <TextArea fx:id="txtCodigo"
                      prefHeight="160"
                      promptText="Escriba aquí el código a analizar..."
                      style="-fx-font-size: 15px;"/>

            <HBox spacing="10">

                <Button text="Optimizar / Analizar"
                        onAction="#onOptimizar"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 25;"/>

                <Button text="Limpiar"
                        onAction="#onLimpiar"
                        style="-fx-background-color: #dc2626;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 25;"/>

            </HBox>

            <Label text="Resultado:"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <TextArea fx:id="txtResultado"
                      editable="false"
                      prefHeight="180"
                      style="-fx-font-size: 14px;"/>

            <Label text="Explicación:"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <TextArea fx:id="txtExplicacion"
                      editable="false"
                      prefHeight="150"
                      style="-fx-font-size: 14px;"/>

        </VBox>

    </center>

</BorderPane>